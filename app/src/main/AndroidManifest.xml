<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Phone control (phone-agent T3): the signal collector fills
         signal.networkType (4G/5G) only when this runtime permission is granted;
         Ajustes requests it. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Phone calendar (phone-calendar T2/T3): read the phone's calendars and
         write an event only after the owner confirms it in the app. Both are
         runtime permissions; Ajustes > CALENDARIO requests them. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Phone health (phone-health T2): read-only Health Connect record types.
         Health Connect grants each one separately; Ajustes > SALUD asks for
         them together and partial grants are a normal answer. The names must
         match HealthPermission.getReadPermission() for the record types in
         HealthConnectPermissions. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <!-- Additional access (Android 14+): the 3 h report runs while the app is
         in the background. It is requested with the rest but not counted as a
         record permission, because older Health Connect builds cannot grant
         it. -->
    <uses-permission
        android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- Phone control enumerates launchable apps to resolve `open <label>`.
         Without this package-visibility declaration Android 11+ hides them.
         Health Connect needs its own package entry, the health-app catalog is
         listed one package per app (never QUERY_ALL_PACKAGES) so detection can
         tell which ones are installed, and MAIN/HOME lets the wellbeing
         aggregation exclude the launchers from screen time. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.mi.health" />
        <package android:name="com.xiaomi.wearable" />
        <package android:name="com.xiaomi.hm.health" />
        <package android:name="com.huami.watch.hmwatchmanager" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="fi.polar.polarflow" />
        <package android:name="com.ouraring.oura" />
        <package android:name="com.strava" />
        <package android:name="com.huawei.health" />
        <package android:name="com.hihonor.health" />
    </queries>

    <!-- Phone status reporting (phone-agent T2): usage minutes per app and the
         foreground app come from UsageStatsManager. This is a special access
         the owner grants in the system settings (Ajustes opens that screen);
         declaring it is what enables the request, it is not a runtime dialog.
         tools:ignore is required because the permission protects app-ops data
         and lint flags it as protected. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".IduPiApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.IDUPI">

        <activity
            android:name="com.idupi.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.idupi.app.service.IduPiForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Phone inbox capture (phone-inbox T3). The system binds this
             service across UIDs, so it is exported but protected by the
             platform's BIND_NOTIFICATION_LISTENER_SERVICE permission: only
             the system, after the owner grants notification access, can bind
             it. The intent-filter action is what makes it a listener. -->
        <service
            android:name="com.idupi.app.data.inbox.InboxNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Phone command execution (phone-agent T3). The system binds this
             service across UIDs after the owner grants accessibility, so it is
             exported but protected by the platform's
             BIND_ACCESSIBILITY_SERVICE permission. The meta-data points to the
             capability/config XML. -->
        <service
            android:name="com.idupi.app.data.phone.control.IdupiAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/idupi_accessibility_service" />
        </service>

        <!-- Phone health (phone-health T2). Health Connect opens this screen
             from the permission dialog ("why does IDUPI need this?"), so it
             must be exported and match the documented action. -->
        <activity
            android:name="com.idupi.app.data.health.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ reaches the same rationale from the system Health
             Connect screens through this alias; the platform permission keeps
             it callable only by the system. -->
        <activity-alias
            android:name="com.idupi.app.data.health.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="com.idupi.app.data.health.HealthPermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- PackageInstaller session verdicts for PC-pushed APKs. The system
             targets this component explicitly, so it stays unexported. -->
        <receiver
            android:name="com.idupi.app.data.install.InstallResultReceiver"
            android:exported="false" />

        <!-- Phone approval notification actions (phone-approvals T2). The
             Aprobar / Rechazar PendingIntents are immutable and target this
             component explicitly, so it stays unexported. -->
        <receiver
            android:name="com.idupi.app.data.phone.approval.ApprovalActionReceiver"
            android:exported="false" />

        <!-- Phone bubble dictation (phone-bubble T5). Launched from the
             accessibility overlay with FLAG_ACTIVITY_NEW_TASK, transparent and
             history-free: it only opens the system recognizer sheet and relays
             the transcript to the bubble. It is never exported and owns no
             microphone permission of its own. -->
        <activity
            android:name="com.idupi.app.data.phone.bubble.VoiceInputActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>