# Copy to keystore.properties (git-ignored) and fill in the real values.
# Used by app/build.gradle.kts to sign release builds (gradlew :app:assembleRelease).
# CI alternative: IDUPI_KEYSTORE_FILE, IDUPI_KEYSTORE_PASSWORD, IDUPI_KEY_ALIAS, IDUPI_KEY_PASSWORD.
#
# storeFile is resolved relative to the app/ module.
storeFile=idupi-release.keystore
storePassword=
keyAlias=idupi
keyPassword=
